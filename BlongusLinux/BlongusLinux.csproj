<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>blongus</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.6" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.6" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\first.txt" LogicalName="Blongus.first.txt" />
    <EmbeddedResource Include="..\second.txt" LogicalName="Blongus.second.txt" />
    <EmbeddedResource Include="..\third.txt" LogicalName="Blongus.third.txt" />
    <EmbeddedResource Include="..\children_cheering.wav" LogicalName="Blongus.children_cheering.wav" />
    <EmbeddedResource Include="Assets\ComicNeue-Bold.ttf" LogicalName="Blongus.ComicNeue-Bold.ttf" />
    <EmbeddedResource Include="Assets\scrimmy.png" LogicalName="Blongus.scrimmy.png" />
  </ItemGroup>

</Project>

